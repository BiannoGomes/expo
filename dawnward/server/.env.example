# Postgres connection string
DATABASE_URL=postgres://becoming:becoming@localhost:5432/becoming

# Anthropic API key, the intelligence layer (never commit the real one).
# In Claude Code cloud environments the name ANTHROPIC_API_KEY is reserved
# and stripped; set DAWNWARD_ANTHROPIC_API_KEY there instead.
ANTHROPIC_API_KEY=
DAWNWARD_ANTHROPIC_API_KEY=

# ElevenLabs key, voice transcription and later the spoken reveals
ELEVENLABS_API_KEY=

# Server
PORT=3000
