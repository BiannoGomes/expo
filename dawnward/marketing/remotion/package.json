{
  "name": "dawnward-films",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio src/index.ts",
    "proof": "remotion render src/index.ts Proof out/proof-9s-9x16.mp4 --codec=h264 --crf=16 --audio-codec=aac --audio-bitrate=256k",
    "flagship": "remotion render src/index.ts Flagship out/raw-60s-captioned.mp4 --codec=h264 --crf=16 --audio-codec=aac --audio-bitrate=320k --concurrency=4",
    "flagship:clean": "remotion render src/index.ts FlagshipClean out/raw-60s-clean.mp4 --codec=h264 --crf=16 --audio-codec=aac --audio-bitrate=320k --concurrency=4",
    "stems": "for s in dialogue music fx; do remotion render src/index.ts FlagshipClean out/stem-$s.wav --codec=wav --props=\"{\\\"captions\\\":false,\\\"stem\\\":\\\"$s\\\"}\"; done",
    "deliver": "sh scripts/deliver.sh"
  },
  "dependencies": {
    "@remotion/cli": "4.0.533",
    "@remotion/media-utils": "4.0.533",
    "@remotion/transitions": "4.0.533",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.533"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}